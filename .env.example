# =============================================================================
# SWING TERMINAL — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Fill in placeholder values and copy to .env for local development.
# Follow the deployment labels below for configuring production services.

# -----------------------------------------------------------------------------
# 🌐 VERCEL ENVIRONMENT VARIABLES (Hobby Free Tier)
# Configure these in Vercel Project Settings -> Environment Variables.
# -----------------------------------------------------------------------------

# Neon pooled connection string using the restricted read-only role (Migration 004):
# e.g., postgresql://web_readonly:password@ep-xyz-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://web_readonly:your-password@ep-xyz-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secret token required to authenticate Vercel Cron jobs calling /api/health
CRON_SECRET="your-secure-random-cron-secret-32-chars-minimum"

# Secret token required to sign and verify owner session JWTs (at least 32 random bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="your-secure-random-auth-secret-32-bytes-minimum"

# Telegram Bot credentials for health check alerts (/api/health)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-telegram-chat-id"

# GitHub repository slug used by /api/health to detect repository inactivity (60-day pause guard)
GITHUB_REPO="dipesh4036/swing"

# Runtime Environment
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# -----------------------------------------------------------------------------
# 🤖 GITHUB ACTIONS SECRETS (Repository Settings -> Secrets and variables -> Actions)
# NEVER put these in Vercel or expose them in client bundles.
# -----------------------------------------------------------------------------

# Angel One SmartAPI credentials (read-only market data session)
API_KEY="your-smartapi-api-key"
CLIENT_ID="your-client-id"
PIN="your-4-digit-pin"
TOTP_SECRET="your-base32-totp-secret"

# Neon PostgreSQL connection string using the OWNER / READ-WRITE role for pipeline sync
DATABASE_URL_OWNER="postgresql://neondb_owner:your-password@ep-xyz-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require"

# GitHub Personal Access Token (or repository GITHUB_TOKEN) for release asset management
GITHUB_TOKEN="ghp_yourPersonalAccessTokenWithReleaseWritePermissions"

# Telegram Bot credentials for pipeline failure alerts and 700 MB storage guard
# (Same values as configured on Vercel above)
# TELEGRAM_BOT_TOKEN
# TELEGRAM_CHAT_ID


# -----------------------------------------------------------------------------
# ⚙️ LOCAL PIPELINE & ADMIN CONFIGURATION (Local Only)
# -----------------------------------------------------------------------------
# Neon owner-role connection string for running migrations or scripts/create-user.mjs (never commit or deploy to Vercel)
ADMIN_DATABASE_URL="postgresql://neondb_owner:your-password@ep-xyz-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require"

RETENTION_YEARS=3
EQUITY_PARQUET_PATH="data/equity_ohlcv.parquet"
